<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Samshine Beauty — Perfumes que marcam presença</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;1,400;1,500&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --roxo-escuro:  #6b4fa0;
  --roxo:         #9b7dd4;
  --roxo-medio:   #b89de0;
  --roxo-claro:   #d9caf0;
  --roxo-palido:  #ede7f9;
  --roxo-nuvem:   #f5f0fd;
  --lavanda:      #e8e0f5;
  --rosa-aurora:  #f2d7e8;
  --pessego:      #fde8d8;
  --sol:          #f9c784;
  --branco:       #fefcff;
  --texto:        #3d2c5e;
  --texto-leve:   #7a6899;
}

html { scroll-behavior: smooth; }
body {
  font-family: 'DM Sans', sans-serif;
  background: var(--branco);
  color: var(--texto);
  overflow-x: hidden;
}

/* ─── NAV ─── */
nav {
  position: fixed; top: 0; left: 0; right: 0; z-index: 200;
  display: flex; align-items: center; justify-content: space-between;
  padding: 1.1rem 3rem;
  background: rgba(254,252,255,0.88);
  backdrop-filter: blur(14px);
  border-bottom: 1px solid rgba(155,125,212,0.12);
}
.nav-logo {
  font-family: 'Playfair Display', serif;
  font-size: 1.35rem; font-style: italic; font-weight: 400;
  color: var(--roxo-escuro); letter-spacing: 0.02em;
  display: flex; align-items: center; gap: 0.4rem;
}
.nav-logo span { font-style: normal; font-size: 1.1rem; }
.nav-links { display: flex; gap: 2.2rem; list-style: none; }
.nav-links a {
  font-size: 0.82rem; font-weight: 400; letter-spacing: 0.08em;
  color: var(--texto-leve); text-decoration: none; transition: color 0.25s;
}
.nav-links a:hover { color: var(--roxo-escuro); }
.nav-btn {
  background: var(--roxo); color: #fff;
  font-size: 0.78rem; font-weight: 500; letter-spacing: 0.08em;
  border: none; padding: 0.6rem 1.4rem; cursor: pointer;
  border-radius: 100px; transition: background 0.25s, transform 0.2s;
}
.nav-btn:hover { background: var(--roxo-escuro); transform: translateY(-1px); }

/* ─── HERO ─── */
#hero {
  min-height: 100vh;
  display: flex; align-items: center;
  position: relative; overflow: hidden;
  padding: 7rem 3rem 4rem;
  background: linear-gradient(160deg,
    #fefcff 0%,
    var(--roxo-nuvem) 30%,
    var(--lavanda) 60%,
    var(--rosa-aurora) 85%,
    var(--pessego) 100%
  );
}

/* flores/orbs de fundo */
.hero-blob {
  position: absolute; border-radius: 50%; pointer-events: none;
  filter: blur(60px); opacity: 0.55;
}
.blob1 { width: 480px; height: 480px; top: -120px; right: -80px;
  background: radial-gradient(circle, #d9caf0, #b89de0, transparent); }
.blob2 { width: 320px; height: 320px; bottom: 60px; left: -60px;
  background: radial-gradient(circle, #fde8d8, #f2d7e8, transparent); opacity: 0.6; }
.blob3 { width: 200px; height: 200px; top: 40%; right: 35%;
  background: radial-gradient(circle, #f9c784, transparent); opacity: 0.3;
  animation: drift 10s ease-in-out infinite; }
@keyframes drift {
  0%,100% { transform: translate(0,0); }
  50% { transform: translate(15px, -20px); }
}

/* pétalas decorativas */
.petala {
  position: absolute; pointer-events: none;
  opacity: 0; animation: cair linear infinite;
}
.petala svg { display: block; }
@keyframes cair {
  0% { opacity: 0; transform: translateY(-40px) rotate(0deg); }
  10% { opacity: 0.6; }
  90% { opacity: 0.4; }
  100% { opacity: 0; transform: translateY(100vh) rotate(360deg); }
}

.hero-inner { position: relative; z-index: 2; display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; width: 100%; max-width: 1100px; }

.hero-text { display: flex; flex-direction: column; gap: 1.4rem; }
.hero-pil {
  display: inline-flex; align-items: center; gap: 0.5rem;
  background: rgba(155,125,212,0.15); color: var(--roxo-escuro);
  font-size: 0.72rem; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase;
  padding: 0.35rem 1rem; border-radius: 100px;
  width: fit-content;
  opacity: 0; animation: fadeUp 0.7s ease forwards 0.15s;
}
.hero-h1 {
  font-family: 'Playfair Display', serif;
  font-size: clamp(2.6rem, 5vw, 4.2rem);
  font-weight: 400; line-height: 1.1; color: var(--texto);
  opacity: 0; animation: fadeUp 0.7s ease forwards 0.3s;
}
.hero-h1 em { font-style: italic; color: var(--roxo-escuro); }
.hero-sub {
  font-size: 1.05rem; font-weight: 300; color: var(--texto-leve);
  line-height: 1.7; max-width: 420px;
  opacity: 0; animation: fadeUp 0.7s ease forwards 0.45s;
}
.hero-btns {
  display: flex; gap: 0.9rem; flex-wrap: wrap;
  opacity: 0; animation: fadeUp 0.7s ease forwards 0.6s;
}
.btn-roxo {
  display: inline-flex; align-items: center; gap: 0.5rem;
  background: var(--roxo); color: #fff;
  font-weight: 500; font-size: 0.9rem;
  padding: 0.85rem 2rem; border-radius: 100px;
  border: none; cursor: pointer; text-decoration: none;
  transition: all 0.25s; box-shadow: 0 4px 20px rgba(155,125,212,0.35);
}
.btn-roxo:hover { background: var(--roxo-escuro); transform: translateY(-2px); box-shadow: 0 8px 28px rgba(107,79,160,0.35); }
.btn-linha {
  display: inline-flex; align-items: center; gap: 0.5rem;
  background: transparent; color: var(--roxo-escuro);
  font-weight: 400; font-size: 0.9rem;
  padding: 0.85rem 2rem; border-radius: 100px;
  border: 1.5px solid var(--roxo-claro); cursor: pointer; text-decoration: none;
  transition: all 0.25s;
}
.btn-linha:hover { border-color: var(--roxo); background: var(--roxo-palido); }

/* visual hero lado direito */
.hero-visual {
  display: flex; align-items: center; justify-content: center;
  position: relative;
  opacity: 0; animation: fadeUp 0.8s ease forwards 0.5s;
}
.hero-card-perfume {
  background: rgba(254,252,255,0.75);
  backdrop-filter: blur(20px);
  border: 1px solid rgba(155,125,212,0.25);
  border-radius: 28px;
  padding: 2.5rem 2rem;
  width: 300px;
  display: flex; flex-direction: column; align-items: center; gap: 1.2rem;
  box-shadow: 0 20px 60px rgba(107,79,160,0.12), 0 4px 16px rgba(107,79,160,0.06);
}
.frasquinho {
  width: 90px; height: 140px;
  background: linear-gradient(160deg, var(--roxo-claro), var(--roxo-medio));
  border-radius: 12px 12px 10px 10px;
  position: relative; display: flex; align-items: flex-end; justify-content: center;
  padding-bottom: 1rem;
  box-shadow: inset 0 20px 40px rgba(255,255,255,0.4), 0 8px 24px rgba(107,79,160,0.2);
  transition: transform 0.4s;
}
.frasquinho:hover { transform: scale(1.06) rotate(-2deg); }
.frasquinho::before {
  content: ''; position: absolute; top: -14px; left: 50%;
  transform: translateX(-50%);
  width: 22px; height: 14px;
  background: var(--roxo-medio);
  border-radius: 4px 4px 0 0;
}
.frasquinho::after {
  content: ''; position: absolute; inset: 0;
  background: linear-gradient(120deg, rgba(255,255,255,0.35) 0%, transparent 60%);
  border-radius: inherit;
}
.frasquinho-label {
  font-family: 'Playfair Display', serif; font-style: italic;
  font-size: 0.8rem; color: var(--roxo-escuro); text-align: center;
  position: relative; z-index: 1;
}
.hero-card-nome { font-family: 'Playfair Display', serif; font-size: 1.2rem; font-weight: 400; text-align: center; color: var(--texto); }
.hero-card-sub { font-size: 0.78rem; color: var(--texto-leve); text-align: center; }
.hero-card-preco { display: flex; align-items: center; gap: 0.7rem; }
.preco-de { font-size: 0.85rem; color: #bbb; text-decoration: line-through; }
.preco-por { font-size: 1.4rem; font-family: 'Playfair Display', serif; color: var(--roxo-escuro); font-weight: 500; }
.desconto-badge {
  background: var(--roxo-palido); color: var(--roxo-escuro);
  font-size: 0.68rem; font-weight: 600; padding: 0.2rem 0.55rem; border-radius: 100px;
}
.hero-card-btn {
  width: 100%; background: var(--roxo); color: #fff;
  font-size: 0.82rem; font-weight: 500; letter-spacing: 0.05em;
  padding: 0.75rem; border-radius: 100px;
  border: none; cursor: pointer; transition: background 0.25s;
}
.hero-card-btn:hover { background: var(--roxo-escuro); }

/* estrelas flutuantes no card */
.float-pill {
  position: absolute;
  background: #fff; border: 1px solid rgba(155,125,212,0.2);
  border-radius: 100px; padding: 0.4rem 0.9rem;
  font-size: 0.75rem; color: var(--texto); font-weight: 400;
  box-shadow: 0 4px 12px rgba(107,79,160,0.1);
  white-space: nowrap;
}
.fp1 { top: -18px; right: -24px; animation: bobUp 4s ease-in-out infinite; }
.fp2 { bottom: 30px; left: -30px; animation: bobUp 4s ease-in-out infinite 1.5s; }
@keyframes bobUp { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }

/* ─── REVEAL GERAL ─── */
.reveal { opacity: 0; transform: translateY(30px); transition: opacity 0.65s ease, transform 0.65s ease; }
.reveal.visible { opacity: 1; transform: translateY(0); }
.d1 { transition-delay: 0.1s; } .d2 { transition-delay: 0.2s; } .d3 { transition-delay: 0.3s; } .d4 { transition-delay: 0.4s; }

@keyframes fadeUp { from { opacity:0; transform:translateY(28px); } to { opacity:1; transform:translateY(0); } }

/* ─── FAIXA SOCIAL ─── */
#faixa {
  background: var(--roxo-nuvem); padding: 2rem 3rem;
  display: flex; align-items: center; justify-content: center; gap: 4rem; flex-wrap: wrap;
  border-top: 1px solid rgba(155,125,212,0.12); border-bottom: 1px solid rgba(155,125,212,0.12);
}
.faixa-item { display: flex; flex-direction: column; align-items: center; }
.faixa-num { font-family: 'Playfair Display', serif; font-size: 2.2rem; font-weight: 500; color: var(--roxo-escuro); line-height: 1; }
.faixa-label { font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--texto-leve); margin-top: 0.25rem; }

/* ─── DEPOIMENTOS ─── */
#prova {
  padding: 6rem 3rem;
  background: linear-gradient(180deg, var(--branco) 0%, var(--roxo-nuvem) 100%);
}
.section-tag { font-size: 0.7rem; font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase; color: var(--roxo); margin-bottom: 0.8rem; }
.section-h2 {
  font-family: 'Playfair Display', serif;
  font-size: clamp(2rem, 3.5vw, 3rem); font-weight: 400; line-height: 1.15;
  color: var(--texto); margin-bottom: 3rem;
}
.section-h2 em { font-style: italic; color: var(--roxo-escuro); }

.deps-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(270px, 1fr)); gap: 1.4rem; }
.card-dep {
  background: #fff; border-radius: 20px;
  border: 1px solid rgba(155,125,212,0.15);
  padding: 1.8rem; display: flex; flex-direction: column; gap: 1rem;
  transition: transform 0.3s, box-shadow 0.3s;
  box-shadow: 0 2px 12px rgba(107,79,160,0.06);
}
.card-dep:hover { transform: translateY(-4px); box-shadow: 0 12px 32px rgba(107,79,160,0.12); }
.dep-stars { color: #c59ae0; font-size: 0.9rem; letter-spacing: 0.05em; }
.dep-quote { font-family: 'Playfair Display', serif; font-style: italic; font-size: 1.05rem; line-height: 1.6; color: var(--texto); }
.dep-autor { font-size: 0.75rem; color: var(--texto-leve); letter-spacing: 0.05em; }
.dep-tag {
  display: inline-block; background: var(--roxo-palido); color: var(--roxo-escuro);
  font-size: 0.65rem; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase;
  padding: 0.2rem 0.6rem; border-radius: 100px; width: fit-content;
}

/* ─── PRODUTOS ─── */
#produtos { padding: 6rem 3rem; background: var(--branco); }

/* banners de marca */
.marcas-titulo { font-size: 0.82rem; color: var(--texto-leve); margin-bottom: 1.5rem; }
.marcas-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 1rem; margin-bottom: 3.5rem;
}
.marca-banner {
  border-radius: 20px; overflow: hidden; cursor: pointer;
  border: 2px solid transparent;
  transition: transform 0.25s, box-shadow 0.25s, border-color 0.25s;
  position: relative; min-height: 110px;
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.5rem;
  text-align: center; padding: 1.2rem 0.8rem;
  box-shadow: 0 2px 12px rgba(107,79,160,0.07);
  text-decoration: none;
}
.marca-banner:hover { transform: translateY(-5px); box-shadow: 0 12px 30px rgba(107,79,160,0.18); }
.marca-banner.ativa { border-color: var(--roxo); box-shadow: 0 8px 24px rgba(107,79,160,0.22); }
.marca-banner.ativa::after {
  content: '✓'; position: absolute; top: 8px; right: 10px;
  background: var(--roxo); color: #fff;
  width: 18px; height: 18px; border-radius: 50%;
  font-size: 0.65rem; display: flex; align-items: center; justify-content: center;
  line-height: 18px;
}

/* cada marca com sua paleta */
.mb-boticario  { background: linear-gradient(145deg, #f0eafa, #ddd0f5); }
.mb-natura     { background: linear-gradient(145deg, #e6f5ec, #c8e8d5); }
.mb-eudora     { background: linear-gradient(145deg, #fdf0f5, #f5d0e0); }
.mb-oui        { background: linear-gradient(145deg, #fdf8ec, #f5e8c0); }
.mb-berenice   { background: linear-gradient(145deg, #fce8f0, #f5b8d0); }

.marca-logo-text {
  font-family: 'Playfair Display', serif;
  font-weight: 500; line-height: 1.15; font-size: 0.92rem;
}
.mb-boticario .marca-logo-text  { color: #5a3a9a; }
.mb-natura .marca-logo-text     { color: #2a6640; }
.mb-eudora .marca-logo-text     { color: #a03060; }
.mb-oui .marca-logo-text        { color: #8a6010; }
.mb-berenice .marca-logo-text   { color: #c02060; }

.marca-sub {
  font-size: 0.65rem; letter-spacing: 0.06em; text-transform: uppercase; opacity: 0.65;
}
.mb-boticario .marca-sub  { color: #5a3a9a; }
.mb-natura .marca-sub     { color: #2a6640; }
.mb-eudora .marca-sub     { color: #a03060; }
.mb-oui .marca-sub        { color: #8a6010; }
.mb-berenice .marca-sub   { color: #c02060; }

.marca-emoji { font-size: 1.8rem; }

/* grid de produtos */
.prods-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(270px, 1fr)); gap: 2rem; }
.card-prod {
  border-radius: 24px; overflow: hidden;
  border: 1px solid rgba(155,125,212,0.15);
  background: #fff; transition: transform 0.3s, box-shadow 0.3s;
  box-shadow: 0 2px 12px rgba(107,79,160,0.06);
}
.card-prod:hover { transform: translateY(-6px); box-shadow: 0 16px 40px rgba(107,79,160,0.14); }
.card-prod.oculto { display: none; }
.prod-topo {
  height: 220px; position: relative;
  display: flex; align-items: center; justify-content: center;
}
.prod-topo.cor1 { background: linear-gradient(135deg, var(--lavanda), var(--roxo-claro), var(--rosa-aurora)); }
.prod-topo.cor2 { background: linear-gradient(135deg, #daf2e4, #b8e0c8, #cce8d8); }
.prod-topo.cor3 { background: linear-gradient(135deg, #fde0ee, #f5c0d8, #f0d0e8); }
.prod-topo.cor4 { background: linear-gradient(135deg, #fdf4d8, #f5e5b0, #f0d890); }
.prod-topo.cor5 { background: linear-gradient(135deg, #fce8f2, #f8c8e0, #f5b8d5); }
.prod-badge-top {
  position: absolute; top: 1rem; left: 1rem;
  background: var(--roxo); color: #fff;
  font-size: 0.65rem; font-weight: 600; letter-spacing: 0.08em;
  padding: 0.3rem 0.75rem; border-radius: 100px;
}
.prod-frasquinho {
  width: 75px; height: 115px;
  border-radius: 10px 10px 8px 8px;
  position: relative;
  display: flex; align-items: flex-end; justify-content: center;
  padding-bottom: 0.65rem;
  transition: transform 0.4s;
  box-shadow: inset 0 16px 30px rgba(255,255,255,0.5), 0 6px 20px rgba(107,79,160,0.18);
}
.prod-frasquinho.f1 { background: linear-gradient(160deg, rgba(185,157,224,0.9), rgba(107,79,160,0.8)); }
.prod-frasquinho.f2 { background: linear-gradient(160deg, rgba(80,160,110,0.8), rgba(40,110,70,0.9)); }
.prod-frasquinho.f3 { background: linear-gradient(160deg, rgba(220,130,160,0.85), rgba(160,60,100,0.9)); }
.prod-frasquinho.f4 { background: linear-gradient(160deg, rgba(220,185,80,0.85), rgba(160,120,20,0.9)); }
.prod-frasquinho.f5 { background: linear-gradient(160deg, rgba(230,110,160,0.85), rgba(180,40,100,0.9)); }
.prod-frasquinho::before {
  content: ''; position: absolute; top: -10px; left: 50%; transform: translateX(-50%);
  width: 18px; height: 10px; border-radius: 3px 3px 0 0;
  background: rgba(107,79,160,0.55);
}
.f2::before { background: rgba(40,110,70,0.6); }
.f3::before { background: rgba(160,60,100,0.6); }
.f4::before { background: rgba(160,120,20,0.6); }
.f5::before { background: rgba(180,40,100,0.6); }
.card-prod:hover .prod-frasquinho { transform: scale(1.08) rotate(-2deg); }
.prod-nome-frasq { font-family: 'Playfair Display', serif; font-style: italic; font-size: 0.68rem; color: rgba(255,255,255,0.92); text-align: center; z-index:1; padding: 0 4px; line-height: 1.3; }

.prod-info { padding: 1.3rem; }
.prod-nome { font-family: 'Playfair Display', serif; font-size: 1.2rem; font-weight: 400; margin-bottom: 0.2rem; }
.prod-marca-label { font-size: 0.72rem; color: var(--texto-leve); margin-bottom: 0.85rem; }
.prod-notas { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-bottom: 1rem; }
.nota {
  font-size: 0.65rem; letter-spacing: 0.06em;
  padding: 0.2rem 0.55rem; border-radius: 100px;
  background: var(--roxo-palido); color: var(--roxo-escuro);
  border: 1px solid rgba(155,125,212,0.2);
}
.prod-rodape { display: flex; align-items: center; justify-content: space-between; }
.preco-bloco { display: flex; align-items: baseline; gap: 0.5rem; }
.p-de { font-size: 0.82rem; color: #c0b8ce; text-decoration: line-through; }
.p-por { font-family: 'Playfair Display', serif; font-size: 1.45rem; font-weight: 500; color: var(--roxo-escuro); }
.btn-prod {
  background: var(--roxo-palido); color: var(--roxo-escuro);
  font-size: 0.78rem; font-weight: 500;
  padding: 0.6rem 1.2rem; border-radius: 100px;
  border: 1.5px solid rgba(155,125,212,0.3); cursor: pointer;
  transition: all 0.25s;
}
.btn-prod:hover { background: var(--roxo); color: #fff; border-color: var(--roxo); }

/* vazio state */
.prods-vazio {
  grid-column: 1/-1; text-align: center; padding: 3rem;
  color: var(--texto-leve); font-size: 0.95rem; display: none;
}

@media (max-width: 900px) {
  .marcas-grid { grid-template-columns: repeat(3, 1fr); }
}
@media (max-width: 560px) {
  .marcas-grid { grid-template-columns: repeat(2, 1fr); }
}

/* ─── SENSORIAL ─── */
#sensorial {
  padding: 6rem 3rem;
  background: linear-gradient(135deg, var(--roxo-nuvem) 0%, var(--lavanda) 40%, var(--rosa-aurora) 80%, var(--pessego) 100%);
  position: relative; overflow: hidden;
}
.sensorial-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: center; }
.sensorial-texto { display: flex; flex-direction: column; gap: 1.6rem; }
.sensorial-quote {
  font-family: 'Playfair Display', serif; font-style: italic;
  font-size: clamp(1.4rem, 2.5vw, 2rem); line-height: 1.4; color: var(--texto);
}
.sensorial-quote strong { color: var(--roxo-escuro); font-style: normal; }
.benes { display: flex; flex-direction: column; gap: 1rem; }
.bene { display: flex; align-items: flex-start; gap: 0.9rem; }
.bene-ic {
  width: 38px; height: 38px; border-radius: 12px;
  background: rgba(155,125,212,0.15);
  display: flex; align-items: center; justify-content: center;
  font-size: 1.1rem; flex-shrink: 0;
}
.bene-info { display: flex; flex-direction: column; }
.bene-t { font-size: 0.88rem; font-weight: 500; margin-bottom: 0.1rem; color: var(--texto); }
.bene-d { font-size: 0.78rem; color: var(--texto-leve); line-height: 1.5; }

/* flor decorativa lado direito */
.flor-container {
  display: flex; align-items: center; justify-content: center;
  position: relative;
}
.flor-svg { width: 280px; height: 280px; animation: giraFlor 25s linear infinite; }
.flor-centro {
