  box-shadow: 0 20px 60px rgba(107,79,160,0.15);
}
.sobre-frame::before {
  content: ''; position: absolute; inset: 0;
  background: linear-gradient(to top, rgba(61,44,94,0.55) 0%, transparent 55%);
}
.sobre-msg {
  position: relative; z-index: 1; padding: 2rem;
